#!/usr/bin/env sh
# Local fail-fast for branch naming. Authoritative check is the GH Action
# `branch-name.yml`. See CLAUDE.md §6 for the full pattern.

branch=$(git rev-parse --abbrev-ref HEAD)

# Allowed — KEEP IN SYNC with .github/workflows/branch-name.yml and
# .claude/hooks/require-pr-template.sh:
#   <type>/<kebab>                 e.g. feat/sender-detail-undo
#   dependabot/<ecosystem>/...     bot-named branches — mirrors the dependabot
#                                  exemption in branch-name.yml
#   (codex|claude|cursor)/<kebab>  harness-assigned branches (Codex companion,
#                                  Claude Code on the web, Cursor cloud
#                                  agents); the session cannot rename them
#   main
# The `d<NNN>-` segment was retired 2026-11-17 with the D-decision system.
if ! echo "$branch" | grep -qE '^(main|dependabot/|(codex|claude|cursor)/[a-z0-9][a-z0-9-]*$|(feat|fix|chore|docs|refactor|test|perf|security)/[a-z0-9])'; then
  echo "✗ pre-push: branch '$branch' does not match CLAUDE.md §6 naming convention." >&2
  echo "  Expected: <type>/<kebab-description> or (codex|claude|cursor)/<kebab>" >&2
  echo "  Allowed types: feat, fix, chore, docs, refactor, test, perf, security" >&2
  exit 1
fi
