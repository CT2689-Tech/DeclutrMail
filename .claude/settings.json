{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(npx:*)",
      "Bash(tsc:*)",
      "Bash(vitest:*)",
      "Bash(playwright:*)",
      "Bash(storybook:*)",
      "Bash(drizzle-kit generate:*)",
      "Bash(drizzle-kit check:*)",
      "Bash(atlas migrate diff:*)",
      "Bash(atlas migrate lint:*)",
      "Bash(atlas migrate status:*)",
      "Bash(atlas migrate hash:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh api:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(cat package.json)",
      "Bash(cat tsconfig*.json)",
      "Bash(cat .eslintrc*)",
      "Bash(cat .prettierrc*)",
      "Bash(cat turbo.json)",
      "Bash(cat pnpm-workspace.yaml)",
      "Bash(ls:*)",
      "Bash(pwd)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git branch -D:*)",
      "Bash(atlas migrate apply:*)",
      "Bash(supabase db push:*)",
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" 2>/dev/null && b=$(git branch --show-current 2>/dev/null) && printf '%s%s' \"${b:-$(git rev-parse --short HEAD 2>/dev/null)}\" \"$(git status --porcelain -uno 2>/dev/null | head -c1 | sed 's/.*/ */')\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-protected-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-bypass-flags.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/block-destructive-cloud-ops.sh"
          }
        ]
      }
    ]
  }
}
