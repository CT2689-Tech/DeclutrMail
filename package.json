{
  "name": "declutrmail",
  "version": "0.0.0",
  "private": true,
  "description": "DeclutrMail — Gmail cleanup SaaS. V2 monorepo.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "e2e": "pnpm --filter @declutrmail/e2e e2e",
    "e2e:a11y": "pnpm --filter @declutrmail/e2e e2e:a11y",
    "e2e:ui": "pnpm --filter @declutrmail/e2e e2e:ui",
    "build": "pnpm -r --parallel build",
    "check:bundle": "node scripts/check-web-bundle-budget.mjs",
    "check:prerender": "node scripts/check-prerendered-routes.mjs",
    "check:icons": "node scripts/generate-brand-icons.mjs --check",
    "check:lighthouse": "pnpm --filter @declutrmail/web exec lhci autorun --config=./lighthouserc.cjs",
    "verify-d": "tsx scripts/verify-d.ts",
    "generate-impl-log": "tsx scripts/generate-impl-log.ts",
    "grant-tier": "tsx scripts/grant-tier.ts",
    "check-changelog": "tsx scripts/check-changelog.ts",
    "status": "tsx scripts/status.ts",
    "db:migrate": "./scripts/db-migrate.sh",
    "db:migrate:status": "./scripts/db-migrate.sh --status",
    "dev:up": "./scripts/dev-up.sh",
    "dev:down": "./scripts/dev-up.sh --stop",
    "dev:auth": "./scripts/dev-auth.sh",
    "prepare": "husky",
    "check-logo": "tsx scripts/check-logo-url.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.18.0",
    "@lhci/cli": "^0.15.1",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postgres": "^3.4.9",
    "prettier": "^3.9.9",
    "sharp": "^0.35.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,md,json,yaml,yml,css}": "prettier --check",
    "apps/web/src/features/marketing/learn/changelog-content.ts": "pnpm check-changelog --"
  }
}
