-- Rollback for 0053_autopilot_entitlement_dismiss_reason.sql
--
-- Postgres has no `ALTER TYPE ... DROP VALUE`, so the 'entitlement'
-- label itself stays in the type — additive and inert: no reader
-- switches exhaustively on dismiss_reason at the DB boundary, and
-- Activity's review-outcome surfaces allowlist ('user','protected')
-- explicitly, so older code simply never sees it (the 0045 precedent).
--
-- What CAN be reversed is the data this migration exists to enable:
-- any row dismissed by the D251 entitlement demotion returns to the
-- approved-but-unapplied state it held before the demotion ran.
UPDATE "rule_match_log"
SET "resolution" = 'approved',
    "resolved_at" = NULL,
    "dismiss_reason" = NULL
WHERE "dismiss_reason" = 'entitlement';
