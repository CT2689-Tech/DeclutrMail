-- Restoring unique(email) is unsafe once two rows share an address.

DO $$
BEGIN
  IF EXISTS (
    SELECT 1
    FROM "entitlement_grants"
    GROUP BY "email"
    HAVING count(*) > 1
  ) THEN
    RAISE EXCEPTION 'duplicate grant emails; cannot restore entitlement_grants_email_uniq';
  END IF;
END $$;
--> statement-breakpoint
DROP INDEX IF EXISTS "entitlement_grants_comp_email_uniq";
--> statement-breakpoint
CREATE UNIQUE INDEX "entitlement_grants_email_uniq" ON "entitlement_grants" ("email");
