-- table (see the forward migration's no-user-linkage note), so there
-- is no retention or deletion obligation attached to discarding it.
--
-- The enums drop after the table that references them.

DROP TABLE IF EXISTS "domain_icons";
--> statement-breakpoint
DROP TYPE IF EXISTS "domain_icon_source";
--> statement-breakpoint
DROP TYPE IF EXISTS "domain_icon_status";
